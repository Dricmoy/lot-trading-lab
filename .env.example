DJANGO_SECRET_KEY=replace-with-a-random-secret
# PostgreSQL is required locally and in deployment. Never point tests at shared data.
# Local compose: postgres://lot:local_disposable_password@127.0.0.1:54329/lot
DATABASE_URL=
# Keep the original DJANGO_SECRET_KEY during migration: it verifies old sessions.
# Compiled C++ executable, invoked directly by Java (no shell or HTTP proxy).
LOT_MATCHING_BINARY=matching/build/lot-matching
PORT=8080
# Set in deployed containers; local Java uses development defaults if omitted.
# LOT_ENV=production

# Private Alpaca data: keep all three server-only. Generate a random 32+ character owner token.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
LOT_OWNER_ACCESS_TOKEN=

# Authentication email links. Local development saves mail to .mailbox/.
# Production password recovery needs an SMTP service and verified sender.
PUBLIC_APP_URL=https://lot-trading-lab.vercel.app
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
