DJANGO_SECRET_KEY=replace-with-a-random-secret
# Required on Vercel; local development defaults to SQLite.
DATABASE_URL=
# Go service locally; use the production origin + /api/engine on Vercel.
MATCHING_ENGINE_URL=http://127.0.0.1:8001/api/engine
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Private Alpaca data: keep all three server-only. Generate a random 32+ character owner token.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
LOT_OWNER_ACCESS_TOKEN=

# Authentication email links. Local development saves mail to .mailbox/.
# Production password recovery needs an SMTP service and verified sender.
PUBLIC_APP_URL=https://lot-trading-lab.vercel.app
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
